@startuml

hide circle
skinparam linetype ortho

' Traducción al español del modelo canónico definido en Mer.puml.
' Ambos diagramas deben mantenerse sincronizados: cualquier cambio de
' entidades, campos o relaciones se hace primero en Mer.puml y luego
' se refleja aquí.

package "Seguridad y Núcleo" {

entity Persona {
  +id_persona : INT <<PK>>
  nombres : VARCHAR(100)
  apellidos : VARCHAR(100)
  correo : VARCHAR(150)
  telefono : VARCHAR(20)
  id_sucursal : INT <<FK>>
}

entity Usuario {
  +id_usuario : INT <<PK>>
  id_persona : INT <<FK>>
  username : VARCHAR(50)
  password_hash : VARCHAR(255)
  estado : VARCHAR(20)
  ultimo_login : DATETIME
}

entity Conductor {
  +id_conductor : INT <<PK>>
  id_persona : INT <<FK>>
  numero_documento : VARCHAR(20)
  licencia_conducir : VARCHAR(50)
  fecha_vencimiento_licencia : DATE
}

entity Rol {
  +id_rol : INT <<PK>>
  nombre : VARCHAR(50)
  descripcion : VARCHAR(255)
}

entity Permiso {
  +id_permiso : INT <<PK>>
  nombre : VARCHAR(50)
  descripcion : VARCHAR(255)
}

entity Rol_Permiso {
  +id_rol : INT <<FK>>
  +id_permiso : INT <<FK>>
}

entity Usuario_Rol {
  +id_usuario : INT <<FK>>
  +id_rol : INT <<FK>>
}

entity Auditoria {
  +id_auditoria : INT <<PK>>
  id_usuario : INT <<FK>>
  accion : VARCHAR(50)
  tabla_afectada : VARCHAR(50)
  fecha : DATETIME
  detalle : TEXT
}
}

package "Operacional y Flota" {

entity Sucursal {
  +id_sucursal : INT <<PK>>
  nombre : VARCHAR(100)
  direccion : VARCHAR(200)
  ciudad : VARCHAR(100)
  telefono : VARCHAR(20)
  horarios : VARCHAR(100)
}

entity Marca {
  +id_marca : INT <<PK>>
  nombre : VARCHAR(50)
}

entity Modelo_Vehiculo {
  +id_modelo : INT <<PK>>
  id_marca : INT <<FK>>
  nombre : VARCHAR(50)
}

entity Categoria {
  +id_categoria : INT <<PK>>
  nombre : VARCHAR(50)
  descripcion : VARCHAR(255)
}

entity Tipo_Motor {
  +id_tipo_motor : INT <<PK>>
  nombre : VARCHAR(50)
}

entity Vehiculo {
  +id_vehiculo : INT <<PK>>
  placa : VARCHAR(10)
  id_modelo : INT <<FK>>
  id_categoria : INT <<FK>>
  id_tipo_motor : INT <<FK>>
  capacidad : INT
  anio : INT
  url_imagen : VARCHAR(255)
  estado : VARCHAR(30)
  kilometraje : DECIMAL(10,2)
  precio_diario : DECIMAL(10,2)
  id_sucursal : INT <<FK>>
}

entity Gps {
  +id_gps : INT <<PK>>
  serial : VARCHAR(100)
  modelo : VARCHAR(50)
  activo : BOOLEAN
}

entity Ubicacion {
  +id_ubicacion : INT <<PK>>
  id_gps : INT <<FK>>
  latitud : DECIMAL(10,8)
  longitud : DECIMAL(11,8)
  timestamp : DATETIME
}

entity Mantenimiento_Vehiculo {
  +id_mantenimiento : INT <<PK>>
  id_vehiculo : INT <<FK>>
  id_tipo_mantenimiento : INT <<FK>>
  fecha_inicio : DATE
  fecha_fin : DATE
  costo : DECIMAL(10,2)
  estado : VARCHAR(30)
}

entity Tipo_Mantenimiento {
  +id_tipo_mantenimiento : INT <<PK>>
  nombre : VARCHAR(50)
  descripcion : VARCHAR(255)
}

}

package "Comercial y Alquiler" {

entity Tipo_Seguro {
  +id_tipo_seguro : INT <<PK>>
  nombre : VARCHAR(100)
  detalle_cobertura : TEXT
  costo_diario : DECIMAL(10,2)
}

entity Reserva {
  +id_reserva : INT <<PK>>
  id_cliente : INT <<FK>>
  id_conductor : INT <<FK>>
  id_vehiculo : INT <<FK>>
  id_tipo_seguro : INT <<FK>>
  id_sucursal_recogida : INT <<FK>>
  id_sucursal_entrega : INT <<FK>>
  fecha_reserva : DATETIME
  fecha_inicio : DATETIME
  fecha_fin : DATETIME
  subtotal_vehiculo : DECIMAL(10,2)
  subtotal_seguro : DECIMAL(10,2)
  monto_total : DECIMAL(10,2)
  estado : VARCHAR(30)
}

entity Contrato {
  +id_contrato : INT <<PK>>
  id_reserva : INT <<FK>>
  numero_contrato : VARCHAR(50)
  fecha_generado : DATETIME
  url_pdf_contrato : VARCHAR(255)
  estado_firma : VARCHAR(20)
  fecha_firma : DATETIME
  ip_firmante : VARCHAR(45)
}

entity Alquiler {
  +id_alquiler : INT <<PK>>
  id_reserva : INT <<FK>>
  id_gps : INT <<FK>>
  fecha_inicio_real : DATETIME
  fecha_fin_real : DATETIME
  kilometraje_inicial : DECIMAL(10,2)
  kilometraje_final : DECIMAL(10,2)
  estado : VARCHAR(30)
}

entity Metodo_Pago {
  +id_metodo : INT <<PK>>
  nombre : VARCHAR(50)
}

entity Pago {
  +id_pago : INT <<PK>>
  id_reserva : INT <<FK>>
  id_metodo : INT <<FK>>
  fecha_pago : DATETIME
  monto : DECIMAL(10,2)
  numero_referencia : VARCHAR(100)
  tipo_pago : VARCHAR(30)
}

entity Notificacion {
  +id_notificacion : INT <<PK>>
  id_persona : INT <<FK>>
  mensaje : TEXT
  fecha_envio : DATETIME
  leido : BOOLEAN
  id_reserva : INT <<FK>>
  id_contrato : INT <<FK>>
  id_pago : INT <<FK>>
  id_mantenimiento : INT <<FK>>
}
}

' Relaciones de Seguridad y Usuarios
Sucursal ||--{ Persona
Persona ||--|| Usuario
Persona ||--{ Conductor
Usuario ||--{ Usuario_Rol
Rol ||--{ Usuario_Rol
Rol ||--{ Rol_Permiso
Permiso ||--{ Rol_Permiso
Usuario ||--{ Auditoria

' Relaciones de Vehículo y Flota
Marca ||--{ Modelo_Vehiculo
Modelo_Vehiculo ||--{ Vehiculo
Categoria ||--{ Vehiculo
Tipo_Motor ||--{ Vehiculo
Sucursal ||--{ Vehiculo
Vehiculo ||--{ Mantenimiento_Vehiculo
Tipo_Mantenimiento ||--{ Mantenimiento_Vehiculo
Gps ||--{ Ubicacion

' Relaciones Comerciales
Tipo_Seguro ||--{ Reserva
Persona ||--{ Reserva : "id_cliente"
Conductor ||--{ Reserva : "id_conductor"
Vehiculo ||--{ Reserva
Sucursal ||--{ Reserva : recogida
Sucursal ||--{ Reserva : entrega
Contrato ||--|| Reserva
Alquiler ||--|| Reserva
Alquiler }|--|| Gps
Reserva ||--{ Pago
Metodo_Pago ||--{ Pago
Persona ||--{ Notificacion
Reserva ||--{ Notificacion
Contrato ||--{ Notificacion
Pago ||--{ Notificacion
Mantenimiento_Vehiculo ||--{ Notificacion

@enduml
